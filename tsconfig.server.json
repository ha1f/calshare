{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/core",
    "src/ports",
    "src/adapters",
    "src/server",
    "worker-configuration.d.ts",
    "test/unit/core",
    "test/unit/adapters",
    "test/unit/server",
    "test/integration"
  ]
}
